# Local development only. Copy this file to .env before starting Docker Compose.
MYSQL_ROOT_PASSWORD=team8_local_root
MYSQL_DATABASE=team8
MYSQL_USER=team8
MYSQL_PASSWORD=team8_local_password

BACKEND_PORT=8080
FRONTEND_PORT=5173
MYSQL_PORT=13306

# NEIS meal API. An empty key uses the public sample mode (up to 5 rows).
API_ENDPOINT=https://open.neis.go.kr/hub/mealServiceDietInfo
API_KEY=
NEIS_OFFICE_CODE=R10
NEIS_SCHOOL_CODE=8750829
API_CONNECT_TIMEOUT=3s
API_READ_TIMEOUT=10s
